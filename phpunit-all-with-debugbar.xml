<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         processIsolation="false"
         stopOnFailure="false"
         cacheResult="true"
         cacheDirectory=".phpunit.cache"
         beStrictAboutOutputDuringTests="false"
         failOnWarning="false"
         timeoutForSmallTests="60"
         timeoutForMediumTests="120"
         timeoutForLargeTests="300"
>
    <testsuites>
        <!-- Optimized tests that work reliably -->
        <testsuite name="Optimized">
            <file>./tests/Unit/ExampleTest.php</file>
            <file>./tests/Unit/SimpleTest.php</file>
            <file>./tests/Unit/HelperTest.php</file>
            <file>./tests/Unit/ConfigurationOptimizedTest.php</file>
            <file>./tests/Unit/RouteOptimizedTest.php</file>
            <file>./tests/Unit/Models/CompanyModelTest.php</file>
            <file>./tests/Unit/Models/CandidateModelTest.php</file>
            <file>./tests/Unit/Models/JobApplicationModelTest.php</file>
            <file>./tests/Unit/Models/JobCategoryModelTest.php</file>
            <file>./tests/Unit/Models/JobTypeModelTest.php</file>
            <file>./tests/Unit/Models/SkillModelTest.php</file>
            <file>./tests/Unit/Models/UserModelOptimizedTest.php</file>
            <file>./tests/Unit/Models/JobModelOptimizedTest.php</file>
            <file>./tests/Unit/Models/UserModelSimpleTest.php</file>
            <file>./tests/Unit/Models/JobModelSimpleTest.php</file>
        </testsuite>
        
        <!-- Include all other unit tests (try with more memory) -->
        <testsuite name="Extended">
            <directory suffix="Test.php">./tests/Unit</directory>
            <!-- Exclude files already in Optimized suite -->
            <exclude>./tests/Unit/ExampleTest.php</exclude>
            <exclude>./tests/Unit/SimpleTest.php</exclude>
            <exclude>./tests/Unit/HelperTest.php</exclude>
            <exclude>./tests/Unit/ConfigurationOptimizedTest.php</exclude>
            <exclude>./tests/Unit/RouteOptimizedTest.php</exclude>
            <exclude>./tests/Unit/Models/CompanyModelTest.php</exclude>
            <exclude>./tests/Unit/Models/CandidateModelTest.php</exclude>
            <exclude>./tests/Unit/Models/JobApplicationModelTest.php</exclude>
            <exclude>./tests/Unit/Models/JobCategoryModelTest.php</exclude>
            <exclude>./tests/Unit/Models/JobTypeModelTest.php</exclude>
            <exclude>./tests/Unit/Models/SkillModelTest.php</exclude>
            <exclude>./tests/Unit/Models/UserModelOptimizedTest.php</exclude>
            <exclude>./tests/Unit/Models/JobModelOptimizedTest.php</exclude>
            <exclude>./tests/Unit/Models/UserModelSimpleTest.php</exclude>
            <exclude>./tests/Unit/Models/JobModelSimpleTest.php</exclude>
        </testsuite>
        
        <!-- Feature tests (if they exist) -->
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    
    <php>
        <server name="APP_ENV" value="testing"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="CACHE_DRIVER" value="array"/>
        <server name="DB_CONNECTION" value="sqlite"/>
        <server name="DB_DATABASE" value=":memory:"/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <server name="APP_DEBUG" value="true"/>
        <server name="DEBUGBAR_ENABLED" value="true"/>
        <server name="LOG_CHANNEL" value="null"/>
        <ini name="memory_limit" value="2G"/>
        <ini name="max_execution_time" value="300"/>
        <ini name="opcache.enable" value="0"/>
        <ini name="xdebug.mode" value="off"/>
        <ini name="error_reporting" value="E_ALL"/>
        <ini name="display_errors" value="1"/>
        <ini name="log_errors" value="1"/>
    </php>
</phpunit> 