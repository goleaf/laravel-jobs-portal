{
    "name": "jobportal-blade",
    "version": "1.0.0",
    "type": "module",
    "description": "Laravel Job Portal - Blade Only Frontend",
    "scripts": {
        "build": "vite build",
        "lint:css": "stylelint 'resources/**/*.{css,scss}' --fix",
        "lint:blade": "blade-formatter --write resources/views/**/*.blade.php",
        "format": "prettier --write 'resources/**/*.{js,css,scss,json}'",
        "format:check": "prettier --check 'resources/**/*.{js,css,scss,json}'"
    },
    "dependencies": {
        "@fontsource/inter": "^5.2.6",
        "alpinejs": "^3.14.9",
        "apexcharts": "^4.7.0",
        "axios": "^1.6.0",
        "chart.js": "^4.5.0",
        "datatables.net": "^2.3.2",
        "datatables.net-dt": "^2.3.2",
        "dropzone": "^6.0.0-beta.2",
        "flatpickr": "^4.6.13",
        "jquery": "^3.7.1",
        "moment": "^2.30.1",
        "select2": "^4.1.0-rc.0",
        "sweetalert2": "^11.22.2",
        "swiper": "^11.2.10"
    },
    "devDependencies": {
        "@fullhuman/postcss-purgecss": "^7.0.2",
        "blade-formatter": "^1.42.2",
        "cssnano": "^7.0.7",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.5.6",
        "postcss-html": "^1.8.0",
        "postcss-import": "^16.1.1",
        "postcss-preset-env": "^10.2.4",
        "prettier": "^3.5.3",
        "stylelint": "^16.20.0",
        "stylelint-config-recommended": "^16.0.0",
        "stylelint-config-standard": "^38.0.0",
        "tailwindcss": "^3.4.17",
        "vite": "^7.0.0"
    }
}
