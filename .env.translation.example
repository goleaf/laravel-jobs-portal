# Translation System Environment Configuration
# Copy these settings to your .env file and adjust as needed

# =============================================================================
# CORE LOCALE SETTINGS
# =============================================================================
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# =============================================================================
# TRANSLATION CACHING
# =============================================================================
TRANSLATION_CACHE_ENABLED=true
TRANSLATION_CACHE_TTL=3600
TRANSLATION_CACHE_PREFIX=translations
TRANSLATION_CACHE_STORE=redis

# =============================================================================
# REDIS CONFIGURATION (Required for optimal performance)
# =============================================================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# TRANSLATION LOADING & PERFORMANCE
# =============================================================================
TRANSLATION_LAZY_LOADING=true
TRANSLATION_MAX_FILE_SIZE=1048576
TRANSLATION_OPCACHE=true
TRANSLATION_COMPRESS_CACHE=false
TRANSLATION_PREFETCH=true
TRANSLATION_MINIMIZE_JSON=true

# =============================================================================
# TRANSLATION VALIDATION & DEBUG
# =============================================================================
TRANSLATION_VALIDATION_ENABLED=true
TRANSLATION_LOG_MISSING_KEYS=true
TRANSLATION_STRICT_MODE=false
TRANSLATION_REPORT_MISSING_KEYS=true
TRANSLATION_DEBUG=false
TRANSLATION_SHOW_MISSING_KEYS=false
TRANSLATION_LOG_USAGE=false
TRANSLATION_PROFILE_PERFORMANCE=false

# =============================================================================
# TRANSLATION MANAGEMENT
# =============================================================================
TRANSLATION_MANAGEMENT_ENABLED=true
TRANSLATION_AUTO_SYNC=false
TRANSLATION_BACKUP_ENABLED=true
TRANSLATION_BACKUP_PATH=storage/app/translation-backups

# =============================================================================
# LOCALE DETECTION
# =============================================================================
TRANSLATION_BROWSER_DETECTION=true
TRANSLATION_COOKIE_PERSISTENCE=true
TRANSLATION_COOKIE_NAME=preferred_locale
TRANSLATION_COOKIE_LIFETIME=43200
TRANSLATION_GEO_DETECTION=false
TRANSLATION_USER_PREFERENCE=true

# =============================================================================
# FRONTEND INTEGRATION
# =============================================================================
TRANSLATION_FRONTEND_ENABLED=true
TRANSLATION_EXPOSE_ALL=false
TRANSLATION_CACHE_FRONTEND=true
TRANSLATION_MINIFY_FRONTEND=true

# =============================================================================
# FORMATTING
# =============================================================================
TRANSLATION_AUTO_FORMAT_DATES=true
TRANSLATION_AUTO_FORMAT_NUMBERS=true
TRANSLATION_AUTO_FORMAT_CURRENCY=true
TRANSLATION_USE_INTL=true

# =============================================================================
# SECURITY & RATE LIMITING
# =============================================================================
TRANSLATION_RATE_LIMIT=true
TRANSLATION_RATE_LIMIT_ATTEMPTS=60
TRANSLATION_RATE_LIMIT_DECAY=60

# =============================================================================
# PRODUCTION OPTIMIZATION SETTINGS
# =============================================================================
# For production environments, use these optimized settings:
# TRANSLATION_CACHE_ENABLED=true
# TRANSLATION_LAZY_LOADING=false
# TRANSLATION_PREFETCH=true
# TRANSLATION_DEBUG=false
# TRANSLATION_VALIDATION_ENABLED=false
# TRANSLATION_LOG_MISSING_KEYS=false