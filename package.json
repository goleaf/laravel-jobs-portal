{
    "name": "jobportal-vue3-spa",
    "version": "2.0.0",
    "type": "module",
    "description": "Laravel Job Portal Vue3 SPA - Enhanced Level 4 Transformation",
    "scripts": {
        "dev": "vite",
        "build": "vite build && npm run copy-manifest",
        "copy-manifest": "cp public/build/.vite/manifest.json public/build/manifest.json 2>/dev/null || true",
        "preview": "vite preview",
        "type-check": "vue-tsc --noEmit",
        "lint": "npm run lint:js && npm run lint:css && npm run lint:blade",
        "lint:js": "eslint resources/js --ext .vue,.js,.jsx,.ts,.tsx --fix",
        "lint:css": "stylelint 'resources/**/*.{css,scss,vue}' --fix",
        "lint:blade": "blade-formatter --write resources/views/**/*.blade.php",
        "lint:check": "npm run lint:js:check && npm run lint:css:check",
        "lint:js:check": "eslint resources/js --ext .vue,.js,.jsx,.ts,.tsx",
        "lint:css:check": "stylelint 'resources/**/*.{css,scss,vue}'",
        "format": "prettier --write 'resources/**/*.{js,ts,vue,css,scss,json}'",
        "format:check": "prettier --check 'resources/**/*.{js,ts,vue,css,scss,json}'",
        "quality": "npm run lint:check && npm run type-check && npm test",
        "quality:fix": "npm run lint && npm run format && npm run type-check",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "cypress run",
        "test:e2e:dev": "cypress open"
    },
    "dependencies": {
        "@fontsource/inter": "^5.2.6",
        "@headlessui/vue": "^1.7.16",
        "@heroicons/vue": "^2.0.18",
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/typography": "^0.5.16",
        "@vitejs/plugin-vue": "^5.0.0",
        "@vuelidate/core": "^2.0.3",
        "@vuelidate/validators": "^2.0.4",
        "alpinejs": "^3.14.9",
        "apexcharts": "^4.7.0",
        "axios": "^1.6.0",
        "chart.js": "^4.5.0",
        "datatables.net": "^2.3.2",
        "datatables.net-dt": "^2.3.2",
        "dropzone": "^6.0.0-beta.2",
        "flatpickr": "^4.6.13",
        "jquery": "^3.7.1",
        "moment": "^2.30.1",
        "pinia": "^2.1.7",
        "select2": "^4.1.0-rc.0",
        "sweetalert2": "^11.22.2",
        "swiper": "^11.2.10",
        "vue": "^3.4.0",
        "vue-i18n": "^9.14.4",
        "vue-loading-overlay": "^6.0.4",
        "vue-router": "^4.2.5",
        "vue-toastification": "^2.0.0-rc.5"
    },
    "devDependencies": {
        "@eslint/config-array": "^0.20.1",
        "@eslint/js": "^9.28.0",
        "@fullhuman/postcss-purgecss": "^7.0.2",
        "@pinia/testing": "^1.0.2",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^20.10.0",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "@vue/test-utils": "^2.4.0",
        "autoprefixer": "^10.4.21",
        "blade-formatter": "^1.42.2",
        "cssnano": "^7.0.7",
        "cypress": "^13.6.0",
        "eslint": "^8.57.1",
        "eslint-plugin-vue": "^9.19.0",
        "jsdom": "^26.1.0",
        "laravel-vite-plugin": "^1.3.0",
        "postcss": "^8.5.6",
        "postcss-html": "^1.8.0",
        "postcss-import": "^16.1.1",
        "postcss-preset-env": "^10.2.4",
        "prettier": "^3.5.3",
        "stylelint": "^16.20.0",
        "stylelint-config-recommended": "^16.0.0",
        "stylelint-config-standard": "^38.0.0",
        "tailwindcss": "^3.4.17",
        "terser": "^5.43.1",
        "typescript": "^5.3.0",
        "vite": "^5.4.0",
        "vitest": "^1.0.0",
        "vue-tsc": "^1.8.25"
    }
}
