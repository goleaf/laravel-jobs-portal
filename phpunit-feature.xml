<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         processIsolation="true"
         stopOnFailure="false"
         cacheResult="false"
         beStrictAboutOutputDuringTests="true"
         failOnWarning="false"
>
    <testsuites>
        <testsuite name="FeatureLite">
            <file>./tests/Feature/ExampleTest.php</file>
            <file>./tests/Feature/ApplicationTest.php</file>
            <file>./tests/Feature/BasicTest.php</file>
        </testsuite>
    </testsuites>
    <php>
        <server name="APP_ENV" value="testing"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="CACHE_DRIVER" value="array"/>
        <server name="DB_CONNECTION" value="sqlite"/>
        <server name="DB_DATABASE" value=":memory:"/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <server name="APP_DEBUG" value="false"/>
        <server name="DEBUGBAR_ENABLED" value="false"/>
        <server name="LOG_CHANNEL" value="null"/>
        <ini name="memory_limit" value="2G"/>
        <ini name="max_execution_time" value="120"/>
        <ini name="opcache.enable" value="0"/>
        <ini name="xdebug.mode" value="off"/>
    </php>
</phpunit> 