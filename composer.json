{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "blade-ui-kit/blade-heroicons": "^2.6",
        "blade-ui-kit/blade-icons": "^1.8",
        "darkaonline/l5-swagger": "^9.0",
        "guzzlehttp/guzzle": "^7.9",
        "laravel/cashier": "^15.0",
        "laravel/framework": "^12.17",
        "laravel/horizon": "^5.32",
        "laravel/pulse": "^1.4",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^10.15",
        "laravel/telescope": "^5.9",
        "laravel/tinker": "^2.10.1",
        "laravel/ui": "^4.2",
        "predis/predis": "^3.0",
        "pusher/pusher-php-server": "^7.2",
        "rennokki/laravel-eloquent-query-cache": "^3.6",
        "spatie/laravel-activitylog": "^4.10",
        "spatie/laravel-backup": "^9.3",
        "spatie/laravel-csp": "^3.13",
        "spatie/laravel-data": "^4.15",
        "spatie/laravel-health": "^1.34",
        "spatie/laravel-honeypot": "^4.6",
        "spatie/laravel-medialibrary": "^11.13",
        "spatie/laravel-permission": "^6.19",
        "spatie/laravel-query-builder": "^6.3",
        "spatie/laravel-ray": "^1.40",
        "spatie/laravel-sluggable": "^3.7",
        "spatie/laravel-translatable": "^6.11",
        "stripe/stripe-php": "^16.2",
        "tymon/jwt-auth": "^2.2",
        "wireui/wireui": "^2.4"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.9",
        "fakerphp/faker": "^1.23",
        "laravel/dusk": "^8.3",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/helpers.php",
            "app/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ],
        "post-update-cmd": [],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "_original_post_autoload_dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ],
        "_original_post_update_cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
